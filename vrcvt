#!/usr/bin/env bash
set -e

# VRCVideoTester (vrcvt) - CLI Entry Point
# Repository: https://github.com/Bluscream/vrcvt

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN="$(which python3 2>/dev/null || which python 2>/dev/null || echo "python3")"

exec "${PYTHON_BIN}" "${SCRIPT_DIR}/src/vrcvt_core.py" "$@"
